        </div>

        <div className="detail">
          <div className="detailvisual">
            {candidate.image ? (
              <img
                src={candidate.image}
                alt={candidate.project}
                style={{
                  width: "100%",
                  height: "100%",
                  objectFit: "cover",
                  borderRadius: 12
                }}
              />
            ) : (
              <div className="detailicon">
                <Shield size={45} />
              </div>
            )}
          </div>

          <div>
            <span className="status">FINALIST</span>

            <h3>{candidate.project}</h3>

            <p className="bio">
              Muallif: <b>{candidate.author}</b>
            </p>

            <p className="bio">{candidate.bio}</p>

            <TaskStars progress={progress} />

            <div className="bar">
              <i style={{ width: `${percent}%` }} />
            </div>

            <div className="infogrid">
