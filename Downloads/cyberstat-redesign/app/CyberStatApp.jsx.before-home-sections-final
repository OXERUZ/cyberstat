export default function CyberStatApp() {
  const [active, setActive] = useState("home");
  const [fullScreen, setFullScreen] = useState(null);
  const [selected, setSelected] = useState(null);
  const [adminMode, setAdminMode] = useState(false);
  const [adminLoginOpen, setAdminLoginOpen] = useState(false);
  const [adminEmail, setAdminEmail] = useState("");
  const [adminPassword, setAdminPassword] = useState("");
  const [adminLoading, setAdminLoading] = useState(false);
  const [adminError, setAdminError] = useState("");
  const [adminUser, setAdminUser] = useState(null);

  const [finalists, setFinalists] = useState(initialFinalists);
  const [results, setResults] = useState(initialResults);

  const [taskProgress, setTaskProgress] = useState(
    Object.fromEntries(
      initialFinalists.map((c) => [c.id, c.progress])
    )
  );

  const loadSupabaseData = async () => {
    try {
      const [finalistsResponse, resultsResponse, tasksResponse] =
        await Promise.all([
          supabase
            .from("cyberstat_finalists")
            .select(
              "id,name,project_name,author_name,bio,image_url,rating,vip,active"
            )
            .eq("active", true)
            .order("id"),

          supabase
            .from("cyberstat_final1_results")
            .select(
              "finalist_id,finalist_name,project_name,votes,percent,frozen"
            )
            .order("finalist_id"),

          supabase
            .from("cyberstat_final2_tasks")
            .select("finalist_id,task_number,completed")
            .order("finalist_id")
            .order("task_number")
        ]);

      if (finalistsResponse.error) {
        console.error(
          "CYBERSTAT finalists error:",
          finalistsResponse.error
        );
      }

      if (resultsResponse.error) {
        console.error(
          "CYBERSTAT results error:",
          resultsResponse.error
        );
      }

      if (tasksResponse.error) {
        console.error(
          "CYBERSTAT tasks error:",
          tasksResponse.error
        );
      }

      if (finalistsResponse.data) {
        const mappedFinalists = finalistsResponse.data.map((item) => ({
          id: item.id,
          name: item.name,
          project: item.project_name,
          author: item.author_name || "",
          bio: item.bio || "",
          image: item.image_url || "",
          rating: Number(item.rating || 0),
          vip: Boolean(item.vip),
          progress: 0
        }));

        setFinalists(mappedFinalists);
      }

      if (resultsResponse.data) {
        const mappedResults = resultsResponse.data.map((item) => ({
          id: item.finalist_id,
          name: item.finalist_name,
          project: item.project_name,
          votes: Number(item.votes || 0),
          percent: Number(item.percent || 0),
          frozen: Boolean(item.frozen)
        }));

        setResults(mappedResults);
      }

      if (tasksResponse.data) {
        const progress = {};

        tasksResponse.data.forEach((task) => {
          if (!progress[task.finalist_id]) {
            progress[task.finalist_id] = 0;
          }

          if (task.completed) {
            progress[task.finalist_id] += 1;
          }
        });

        setTaskProgress(progress);

        setFinalists((current) =>
          current.map((candidate) => ({
            ...candidate,
            progress: progress[candidate.id] ?? 0
          }))
        );
      }
    } catch (error) {
      console.error("CYBERSTAT Supabase yuklash xatosi:", error);
    }
  };

  useEffect(() => {
    loadSupabaseData();

    const channel = supabase
      .channel("cyberstat-live")
      .on(
        "postgres_changes",
        {
          event: "*",
          schema: "public",
          table: "cyberstat_finalists"
        },
        loadSupabaseData
      )
      .on(
        "postgres_changes",
        {
          event: "*",
          schema: "public",
          table: "cyberstat_final2_tasks"
        },
        loadSupabaseData
      )
      .on(
        "postgres_changes",
        {
          event: "*",
          schema: "public",
          table: "cyberstat_final1_results"
        },
        loadSupabaseData
      )
      .subscribe();

    return () => {
      supabase.removeChannel(channel);
    };
  }, []);

  const go = (section) => {
    setActive(section);

    setTimeout(() => {
      document
        .getElementById(section)
        ?.scrollIntoView({
          behavior: "smooth",
          block: "start"
        });
    }, 50);
  };

  const updateFinalist = (id, field, value) => {
    setFinalists((prev) =>
      prev.map((candidate) =>
        candidate.id === id
          ? { ...candidate, [field]: value }
          : candidate
      )
    );
  };

  const updateResult = (id, field, value) => {
    setResults((prev) =>
      prev.map((result) =>
        result.id === id
          ? { ...result, [field]: value }
          : result
      )
    );
  };

  const toggleTask = (id, index) => {
    setTaskProgress((prev) => {
      const current = prev[id] ?? 0;

      const next =
        index < current
          ? index
          : index === current
          ? current + 1
          : current;

      return {
        ...prev,
        [id]: Math.max(
          0,
          Math.min(TASK_COUNT, next)
        )
      };
    });
  };

  const uploadFinalistImage = async (finalistId, file) => {
    try {
      if (!file.type.startsWith("image/")) {
        alert("Faqat rasm fayllarini yuklash mumkin.");
        return;
      }

      const maxSize = 5 * 1024 * 1024;

      if (file.size > maxSize) {
        alert("Rasm hajmi 5 MB dan oshmasligi kerak.");
        return;
      }

      const extension =
        file.name.split(".").pop()?.toLowerCase() || "jpg";

      const filePath =
        `authors/${finalistId}-${Date.now()}.${extension}`;

      const { error: uploadError } = await supabase.storage
        .from("candidate-images")
        .upload(filePath, file, {
          cacheControl: "3600",
          upsert: false,
          contentType: file.type
        });

      if (uploadError) {
        throw uploadError;
      }

      const { data: publicData } = supabase.storage
        .from("candidate-images")
        .getPublicUrl(filePath);

      if (!publicData?.publicUrl) {
        throw new Error("Rasm URL olinmadi.");
      }

      updateFinalist(
        finalistId,
        "image",
        publicData.publicUrl
      );

      alert("Finalist rasmi muvaffaqiyatli yuklandi.");
    } catch (error) {
      console.error("IMAGE UPLOAD ERROR:", error);
      alert(
        error?.message ||
        "Rasmni yuklashda xatolik yuz berdi."
      );
    }
  };

  const saveChanges = async () => {
    try {
      for (const candidate of finalists) {
        const { error: finalistError } = await supabase.rpc(
          "cyberstat_admin_save_finalist",
          {
            p_id: candidate.id,
            p_name: candidate.name,
            p_project_name: candidate.project,
            p_author_name: candidate.author || "",
            p_bio: candidate.bio || "",
            p_image_url: candidate.image || "",
            p_rating: Number(candidate.rating || 0),
            p_vip: Boolean(candidate.vip)
          }
        );

        if (finalistError) {
          throw finalistError;
        }

        const { error: taskError } = await supabase.rpc(
          "cyberstat_admin_set_all_tasks",
          {
            p_finalist_id: candidate.id,
            p_completed_count: taskProgress[candidate.id] ?? 0
          }
        );

        if (taskError) {
          throw taskError;
        }
      }

      for (const result of results) {
        const { error: resultError } = await supabase.rpc(
          "cyberstat_admin_save_result",
          {
            p_finalist_id: result.id,
            p_votes: Number(result.votes || 0),
            p_percent: Number(result.percent || 0),
            p_frozen: result.frozen !== false
          }
        );

        if (resultError) {
          throw resultError;
        }
      }

      await loadSupabaseData();

      alert("O‘zgarishlar Supabase bazasiga muvaffaqiyatli saqlandi.");
    } catch (error) {
      console.error("CYBERSTAT ADMIN SAVE ERROR:", error);

      alert(
        "Saqlashda xato: " +
        (error?.message || "Noma'lum xato")
      );
    }
  };

  const openAdminPanel = async () => {
    const { data } = await supabase.auth.getSession();

    if (data?.session) {
      const { data: adminCheck, error } = await supabase.rpc(
        "cyberstat_admin_status"
      );

      if (!error && adminCheck === true) {
        setAdminUser(data.session.user);
        setAdminMode(true);
        setActive("admin");
        return;
      }
    }

    setAdminLoginOpen(true);
    setAdminError("");
  };

  const loginAdmin = async (event) => {
    event.preventDefault();

    setAdminLoading(true);
    setAdminError("");

    try {
      const { data, error } = await supabase.auth.signInWithPassword({
        email: adminEmail.trim(),
        password: adminPassword
      });

      if (error) {
        throw error;
      }

      const { data: isAdmin, error: adminError } =
        await supabase.rpc("cyberstat_admin_status");

      if (adminError) {
        await supabase.auth.signOut();
        throw adminError;
      }

      if (isAdmin !== true) {
        await supabase.auth.signOut();
        throw new Error("Bu hisobda admin huquqi mavjud emas.");
      }

      setAdminUser(data.user);
      setAdminLoginOpen(false);
      setAdminMode(true);
      setActive("admin");
      setAdminPassword("");
    } catch (error) {
      console.error("CYBERSTAT ADMIN LOGIN ERROR:", error);

      setAdminError(
        error?.message || "Login amalga oshmadi."
      );
    } finally {
      setAdminLoading(false);
    }
  };

  const logoutAdmin = async () => {
    await supabase.auth.signOut();

    setAdminUser(null);
    setAdminMode(false);
    setActive("home");
  };

  const nav = [
    ["home", "Bosh sahifa"],
    ["final2", "Final 2"],
    ["results", "Natijalar"],
  ];

  const renderFinal2Screen = () => (
    <div className="fullscreen-screen">
      <div className="fullscreen-grid" />

      <header className="fullscreen-header">
        <button
          className="fullscreen-back"
          onClick={() => setFullScreen(null)}
        >
          ← ORQAGA
        </button>

        <div className="fullscreen-title">
          <span>CYBERSTAT / FINAL 02</span>
          <h1>FINAL 2 NI KUZATISH</h1>
          <p>
            Yopiq cyber challenge. Finalistlarning faqat
            bajarilish progressi ommaga ko‘rsatiladi.
          </p>
        </div>

        <div className="fullscreen-status">
          <i />
          JONLI
        </div>
      </header>

      <main className="fullscreen-content">
        <div className="fullscreen-section-head">
          <div>
            <small>FINAL 02 / YOPIQ CHALLENGE</small>
            <h2>FINALISTLAR</h2>
          </div>

          <span className="status">
            <LockKeyhole size={12} />
            10 TA TOPSHIRIQ
          </span>
        </div>

        <div className="fullscreen-cards">
          {[...finalists]
            .sort((a, b) => {
              if (a.vip && !b.vip) return -1;
              if (!a.vip && b.vip) return 1;
              return Number(a.id) - Number(b.id);
            })
            .map((candidate, index) => {
              const progress =
                taskProgress[candidate.id] ?? 0;

              const percent =
                (progress / TASK_COUNT) * 100;

              return (
                <article
                  className={
                    "fullscreen-card " +
                    (candidate.vip ? "vip-card" : "")
                  }
                  key={candidate.id}
                  onClick={() => setSelected(candidate)}
                >
                  <div className="fullscreen-image">
                    {candidate.image ? (
                      <img
                        src={candidate.image}
                        alt={candidate.project}
                      />
                    ) : (
                      <div className="fullscreen-image-placeholder">
                        {index === 0 ? (
