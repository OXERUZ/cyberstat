export default function CyberStatApp() {
  const [active, setActive] = useState("home");
  const [fullScreen, setFullScreen] = useState(null);
  const [selected, setSelected] = useState(null);
  const [adminMode, setAdminMode] = useState(false);
  const [adminLoginOpen, setAdminLoginOpen] = useState(false);
  const [adminEmail, setAdminEmail] = useState("");
  const [adminPassword, setAdminPassword] = useState("");
  const [adminLoading, setAdminLoading] = useState(false);
  const [adminError, setAdminError] = useState("");
  const [adminUser, setAdminUser] = useState(null);

  const [finalists, setFinalists] = useState(initialFinalists);
  const [results, setResults] = useState(initialResults);

  const [taskProgress, setTaskProgress] = useState(
    Object.fromEntries(
      initialFinalists.map((c) => [c.id, c.progress])
    )
  );

  const loadSupabaseData = async () => {
    try {
      const [finalistsResponse, resultsResponse, tasksResponse] =
        await Promise.all([
          supabase
            .from("cyberstat_finalists")
            .select(
              "id,name,project_name,author_name,bio,image_url,final1_image_url,final2_image_url,rating,vip,active"
            )
            .eq("active", true)
            .order("id"),

          supabase
            .from("cyberstat_final1_results")
            .select(
              "finalist_id,finalist_name,project_name,votes,percent,frozen"
            )
            .order("finalist_id"),

          supabase
            .from("cyberstat_final2_tasks")
            .select("finalist_id,task_number,completed")
            .order("finalist_id")
            .order("task_number")
        ]);

      if (finalistsResponse.error) {
        console.error(
          "CYBERSTAT finalists error:",
          finalistsResponse.error
        );
      }

      if (resultsResponse.error) {
        console.error(
          "CYBERSTAT results error:",
          resultsResponse.error
        );
      }

      if (tasksResponse.error) {
        console.error(
          "CYBERSTAT tasks error:",
          tasksResponse.error
        );
      }

      if (finalistsResponse.data) {
        const mappedFinalists = finalistsResponse.data.map((item) => ({
          id: item.id,
          name: item.name,
          project: item.project_name,
          author: item.author_name || "",
          bio: item.bio || "",
          final1Image: item.final1_image_url || item.image_url || "",
          final2Image: item.final2_image_url || "",
          rating: Number(item.rating || 0),
          vip: Boolean(item.vip),
          progress: 0
        }));

        setFinalists(mappedFinalists);
      }

      if (resultsResponse.data) {
        const mappedResults = resultsResponse.data.map((item) => ({
          id: item.finalist_id,
          name: item.finalist_name,
          project: item.project_name,
          votes: Number(item.votes || 0),
          percent: Number(item.percent || 0),
          frozen: Boolean(item.frozen)
        }));

        setResults(mappedResults);
      }

      if (tasksResponse.data) {
        const progress = {};

        tasksResponse.data.forEach((task) => {
          if (!progress[task.finalist_id]) {
            progress[task.finalist_id] = 0;
          }

          if (task.completed) {
            progress[task.finalist_id] += 1;
          }
        });

        setTaskProgress(progress);

        setFinalists((current) =>
          current.map((candidate) => ({
            ...candidate,
            progress: progress[candidate.id] ?? 0
          }))
        );
      }
    } catch (error) {
      console.error("CYBERSTAT Supabase yuklash xatosi:", error);
    }
  };

  useEffect(() => {
    loadSupabaseData();

    const channel = supabase
      .channel("cyberstat-live")
      .on(
        "postgres_changes",
        {
          event: "*",
          schema: "public",
          table: "cyberstat_finalists"
        },
        loadSupabaseData
      )
      .on(
        "postgres_changes",
        {
          event: "*",
          schema: "public",
          table: "cyberstat_final2_tasks"
        },
        loadSupabaseData
      )
      .on(
        "postgres_changes",
        {
          event: "*",
          schema: "public",
          table: "cyberstat_final1_results"
        },
        loadSupabaseData
      )
      .subscribe();

    return () => {
      supabase.removeChannel(channel);
    };
  }, []);

  const go = (section) => {
    setActive(section);

    setTimeout(() => {
      document
        .getElementById(section)
        ?.scrollIntoView({
          behavior: "smooth",
          block: "start"
        });
    }, 50);
  };

  const updateFinalist = (id, field, value) => {
    setFinalists((prev) =>
      prev.map((candidate) =>
        candidate.id === id
          ? { ...candidate, [field]: value }
          : candidate
      )
    );
  };

  const updateResult = (id, field, value) => {
    setResults((prev) =>
      prev.map((result) =>
        result.id === id
          ? { ...result, [field]: value }
          : result
      )
    );
  };

  const toggleTask = (id, index) => {
    setTaskProgress((prev) => {
      const current = prev[id] ?? 0;

      const next =
        index < current
          ? index
          : index === current
          ? current + 1
          : current;

      return {
        ...prev,
        [id]: Math.max(
          0,
          Math.min(TASK_COUNT, next)
        )
      };
    });
  };

  const uploadFinalistImage = async (finalistId, file, finalType) => {
    if (!file) return;

    try {
      const extension =
        file.name.split(".").pop()?.toLowerCase() || "webp";

      const finalist = finalists.find(
        (candidate) => candidate.id === finalistId
      );

      const safeName = (
        finalist?.name ||
        `finalist-${finalistId}`
      )
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-|-$/g, "");

      const filePath =
        `${finalType}/${finalistId}-${safeName}-${Date.now()}.${extension}`;

      const { error: uploadError } = await supabase.storage
        .from("candidate-images")
        .upload(filePath, file, {
          upsert: true,
          contentType: file.type || undefined,
        });

      if (uploadError) {
        throw uploadError;
      }

      const { data: publicData } = supabase.storage
        .from("candidate-images")
        .getPublicUrl(filePath);

      if (!publicData?.publicUrl) {
        throw new Error("Rasm uchun public URL olinmadi.");
      }

      updateFinalist(
        finalistId,
        finalType === "final1" ? "final1Image" : "final2Image",
        publicData.publicUrl
      );

      alert(
        `${finalType === "final1" ? "FINAL 1" : "FINAL 2"} rasmi yuklandi.`
      );
    } catch (error) {
      console.error("Finalist image upload error:", error);
      alert(`Rasm yuklashda xatolik: ${error.message}`);
    }
  };

  const saveChanges = async () => {
    try {
      for (const candidate of finalists) {
        const { error: finalistError } = await supabase.rpc(
          "cyberstat_admin_save_finalist_v2",
          {
            p_id: candidate.id,
            p_name: candidate.name,
            p_project_name: candidate.project,
            p_author_name: candidate.author || "",
            p_bio: candidate.bio || "",
            p_final1_image_url: candidate.final1Image || "",
            p_final2_image_url: candidate.final2Image || "",
            p_rating: Number(candidate.rating || 0),
            p_vip: Boolean(candidate.vip)
          }
        );

        if (finalistError) {
          throw finalistError;
        }

        const { error: taskError } = await supabase.rpc(
          "cyberstat_admin_set_all_tasks",
          {
            p_finalist_id: candidate.id,
            p_completed_count: taskProgress[candidate.id] ?? 0
          }
        );

        if (taskError) {
          throw taskError;
        }
      }

      for (const result of results) {
        const { error: resultError } = await supabase.rpc(
          "cyberstat_admin_save_result",
          {
            p_finalist_id: result.id,
            p_votes: Number(result.votes || 0),
            p_percent: Number(result.percent || 0),
            p_frozen: result.frozen !== false
          }
        );

        if (resultError) {
          throw resultError;
        }
      }

      await loadSupabaseData();

      alert("O‘zgarishlar Supabase bazasiga muvaffaqiyatli saqlandi.");
    } catch (error) {
      console.error("CYBERSTAT ADMIN SAVE ERROR:", error);

      alert(
        "Saqlashda xato: " +
        (error?.message || "Noma'lum xato")
      );
    }
  };

  const openAdminPanel = async () => {
    const { data } = await supabase.auth.getSession();

    if (data?.session) {
      const { data: adminCheck, error } = await supabase.rpc(
        "cyberstat_admin_status"
      );

      if (!error && adminCheck === true) {
        setAdminUser(data.session.user);
        setAdminMode(true);
        setActive("admin");
        return;
      }
    }

    setAdminLoginOpen(true);
    setAdminError("");
  };

  const loginAdmin = async (event) => {
    event.preventDefault();

    setAdminLoading(true);
    setAdminError("");

    try {
      const { data, error } = await supabase.auth.signInWithPassword({
        email: adminEmail.trim(),
        password: adminPassword
      });

      if (error) {
        throw error;
      }

      const { data: isAdmin, error: adminError } =
        await supabase.rpc("cyberstat_admin_status");

      if (adminError) {
        await supabase.auth.signOut();
        throw adminError;
      }

      if (isAdmin !== true) {
        await supabase.auth.signOut();
        throw new Error("Bu hisobda admin huquqi mavjud emas.");
      }

      setAdminUser(data.user);
      setAdminLoginOpen(false);
      setAdminMode(true);
      setActive("admin");
      setAdminPassword("");
    } catch (error) {
      console.error("CYBERSTAT ADMIN LOGIN ERROR:", error);

      setAdminError(
        error?.message || "Login amalga oshmadi."
      );
    } finally {
      setAdminLoading(false);
    }
  };

  const logoutAdmin = async () => {
    await supabase.auth.signOut();

    setAdminUser(null);
    setAdminMode(false);
    setActive("home");
  };

  const nav = [
    ["home", "Bosh sahifa"],
    ["final2", "Final 2"],
    ["results", "Natijalar"],
  ];

  const renderFinal2Screen = () => (
    <div className="fullscreen-screen">
      <div className="fullscreen-grid" />

      <header className="fullscreen-header">
        <button
          className="fullscreen-back"
          onClick={() => setFullScreen(null)}
        >
          ← ORQAGA
        </button>

        <div className="fullscreen-title">
          <span>CYBERSTAT / FINAL 02</span>
          <h1>FINAL 2 NI KUZATISH</h1>
          <p>
            Yopiq cyber challenge. Finalistlarning faqat
            bajarilish progressi ommaga ko‘rsatiladi.
          </p>
        </div>

        <div className="fullscreen-status">
          <i />
          JONLI
        </div>
      </header>

      <main className="fullscreen-content">
        <div className="fullscreen-section-head">
          <div>
            <small>FINAL 02 / YOPIQ CHALLENGE</small>
            <h2>FINALISTLAR</h2>
          </div>

          <span className="status">
            <LockKeyhole size={12} />
            10 TA TOPSHIRIQ
          </span>
        </div>

        <div className="fullscreen-cards">
          {[...finalists]
            .sort((a, b) => {
              if (a.vip && !b.vip) return -1;
              if (!a.vip && b.vip) return 1;
              return Number(a.id) - Number(b.id);
            })
            .map((candidate, index) => {
              const progress =
                taskProgress[candidate.id] ?? 0;

              const percent =
                (progress / TASK_COUNT) * 100;

              return (
                <article
                  className={
                    "fullscreen-card " +
                    (candidate.vip ? "vip-card" : "")
                  }
                  key={candidate.id}
                  onClick={() => setSelected(candidate)}
                >
                  <div className="fullscreen-image">
                    {candidate.final2Image ? (
                      <img
                        src={candidate.final2Image}
                        alt={candidate.project}
                      />
                    ) : (
                      <div className="fullscreen-image-placeholder">
                        {index === 0 ? (
                          <Shield size={50} />
                        ) : index === 1 ? (
                          <Activity size={50} />
                        ) : (
                          <Zap size={50} />
                        )}
                      </div>
                    )}
                  </div>

                  <div className="fullscreen-card-body">
                    <div className="fullscreen-card-top">
                      <span className="rank">
                        #{candidate.id}
                      </span>

                    </div>

                    <small>FINALIST</small>

                    <h3>{candidate.project}</h3>

                    <strong>{candidate.name}</strong>

                    <p>{candidate.bio}</p>

                    <div className="fullscreen-progress-head">
                      <span>TOPSHIRIQLAR</span>
                      <b>
                        {progress} / {TASK_COUNT}
                      </b>
                    </div>

                    <TaskStars progress={progress} />

                    <div className="fullscreen-progress">
                      <i
                        style={{
                          width: `${percent}%`
                        }}
                      />
                    </div>

                    <div className="fullscreen-card-footer">
                      <span>
                        {percent}% BAJARILGAN
                      </span>

                      <span>
                        {candidate.rating.toFixed(1)} / 5.0
                      </span>
                    </div>
                  </div>
                </article>
              );
            })}
        </div>
      </main>
    </div>
  );

  const renderResultsScreen = () => (
    <div className="fullscreen-screen results-screen">
      <div className="fullscreen-grid" />

      <header className="fullscreen-header">
        <button
          className="fullscreen-back"
          onClick={() => setFullScreen(null)}
        >
          ← ORQAGA
        </button>

        <div className="fullscreen-title">
          <span>CYBERSTAT / FINAL 01</span>
          <h1>FINAL 1 NATIJALARI</h1>
          <p>
            Ovoz berish yakunlangan. Quyidagi natijalar
            rasmiy va muzlatilgan.
          </p>
        </div>

        <div className="fullscreen-status frozen">
          <CheckCircle2 size={14} />
          MUZLATILGAN
        </div>
      </header>

      <main className="fullscreen-content">
        <div className="fullscreen-section-head">
          <div>
            <small>FINAL 01 / RASMIY NATIJALAR</small>
            <h2>YAKUNIY NATIJALAR</h2>
          </div>

          <span className="status">
            <LockKeyhole size={12} />
            OVOZ BERISH YOPIQ
          </span>
        </div>

        <div className="results-fullscreen-grid">
          {results
            .slice()
            .sort((a, b) => b.votes - a.votes)
            .map((result, index) => {
              const finalist = finalists.find(
                (candidate) => candidate.id === result.id
              );

              return (
                <article
                  className={
                    "result-fullscreen-card " +
                    (index === 0 ? "winner-card" : "")
                  }
                  key={result.id}
                >
                  <div className="result-rank">
                    #{index + 1}
                  </div>

                  <div className="result-photo">
                    {finalist?.final1Image ? (
                      <img
                        src={finalist.final1Image}
                        alt={result.project}
                      />
                    ) : (
                      <Trophy size={32} />
                    )}
                  </div>

                  <div className="result-info">
                    <small>#{result.id} FINALIST</small>

                    <h3>{result.project}</h3>

                    <strong>{result.name}</strong>

                    <div className="result-bar">
                      <i
                        style={{
                          width: `${result.percent}%`
                        }}
                      />
                    </div>
                  </div>

                  <div className="result-number">
                    <strong>
                      {result.votes.toLocaleString()}
                    </strong>

                    <span>{result.percent}%</span>
                  </div>

                  {index === 0 && (
                    <div className="winner-label">
                      ★ 1-O‘RIN · VIP NOMINANT
                    </div>
                  )}
                </article>
              );
            })}
        </div>
      </main>
    </div>
  );

  return (
    <div className="app">
      <div className="grid" />
      <div className="topline" />

      <header className="nav">
        <button
          className="brand"
          onClick={() => go("home")}
        >
          <span className="logo">
            <Shield />
          </span>

          <span>
            <strong>CYBERSTAT</strong>
            <small>DIGITAL COMPETITION ARENA</small>
          </span>
        </button>

        <nav className="links">
          {nav.map(([id, label]) => (
            <button
              className={active === id ? "active" : ""}
              onClick={() => {
                if (id === "final2" || id === "results") {
                  setActive(id);
                  setFullScreen(id);
                  return;
                }
                go(id);
              }}
              key={id}
            >
              {label}
            </button>
          ))}
        </nav>

        <span className="live">
          <i className="dot" />
          JONLI
        </span>

        <button
          className={
            adminMode
              ? "admin active"
              : "admin"
          }
          onClick={openAdminPanel}
        >
          ADMIN PANELI
        </button>
      </header>

      {adminLoginOpen && (
        <div
          className="modal-backdrop"
          onClick={() => {
            if (!adminLoading) {
              setAdminLoginOpen(false);
              setAdminError("");
            }
          }}
        >
          <div
            className="modal"
            onClick={(event) => event.stopPropagation()}
          >
            <div className="modal-head">
              <div>
                <span className="eyebrow">CYBERSTAT SECURITY</span>
                <h2>ADMIN KIRISH</h2>
              </div>

              <button
                className="iconbtn"
                onClick={() => {
                  if (!adminLoading) {
                    setAdminLoginOpen(false);
                    setAdminError("");
                  }
                }}
              >
                ×
              </button>
            </div>

            <form onSubmit={loginAdmin}>
              <label>
                ADMIN EMAIL
                <input
                  type="email"
                  value={adminEmail}
                  onChange={(event) =>
                    setAdminEmail(event.target.value)
                  }
                  placeholder="admin@cyberstat.uz"
                  autoComplete="username"
                  required
                />
              </label>

              <label>
                PAROL
                <input
                  type="password"
                  value={adminPassword}
                  onChange={(event) =>
                    setAdminPassword(event.target.value)
                  }
                  placeholder="••••••••"
                  autoComplete="current-password"
                  required
                />
              </label>

              {adminError && (
                <div className="errorbox">
                  {adminError}
                </div>
              )}

              <button
                className="primary"
                type="submit"
                disabled={adminLoading}
              >
                {adminLoading
                  ? "TEKSHIRILMOQDA..."
                  : "ADMIN SIFATIDA KIRISH"}
              </button>
            </form>
          </div>
        </div>
      )}

      <main>
        {/* HERO */}
        <section
          className="hero container"
          id="home"
        >
          {/* LEFT SIDE */}
          <div className="hero-copy">
            <div className="kicker">
              <i />
              KIBERXAVFSIZLIK × INNOVATSIYA × KELAJAK
            </div>

            <h1>CYBERSTAT</h1>

            <h2>DIGITAL COMPETITION ARENA</h2>

            <p>
              Yilning eng yirik kiber loyihalari tanlovi.
              <br />
              Eng kuchli loyihalar. Eng yangi texnologiyalar.
              <br />
              Bitta raqamli arena.
            </p>

            <div className="actions">
              <button
                className="primary"
                onClick={() => setFullScreen("final2")}
              >
                FINAL 2 NI KUZATISH
                <span>→</span>
              </button>

              <button
                className="secondary"
                onClick={() => setFullScreen("results")}
              >
                FINAL 1 NATIJALARI
                <span>→</span>
              </button>
            </div>
          </div>

          {/* RIGHT SIDE — FINAL 1 WINNER */}
          <div className="hero-art winner-orbit-art">
            <div className="winner-orbit">
              <div className="orbit-ring orbit-ring-1" />
              <div className="orbit-ring orbit-ring-2" />
              <div className="orbit-ring orbit-ring-3" />

              <div className="winner-orbit-label">
                ★ FINAL 1 G‘OLIBI
              </div>

              <div className="winner-core">
                <div className="winner-image-glow" />

                {finalists.find((candidate) => candidate.vip)?.final1Image ? (
                  <img
                    src={finalists.find((candidate) => candidate.vip)?.final1Image}
                    alt="XOSHIMOV XOSHIMXON"
                    className="winner-orbit-image"
                  />
                ) : (
                  <div className="winner-orbit-placeholder">
                    <Trophy size={52} />
                  </div>
                )}

                <div className="winner-core-border" />
              </div>

              <div className="winner-orbit-info">
                <strong>XOSHIMOV XOSHIMXON</strong>
                <span>NOVA GUARD</span>
                <b>★ 1-O‘RIN · VIP NOMZOD</b>
              </div>
            </div>
          </div>
        </section>

      </main>

      {/* ADMIN */}
      {adminMode && (
        <AdminPanel
          finalists={finalists}
          results={results}
          taskProgress={taskProgress}
          updateFinalist={updateFinalist}
          updateResult={updateResult}
          toggleTask={toggleTask}
          saveChanges={saveChanges}
          uploadFinalistImage={uploadFinalistImage}
        />
      )}

      {fullScreen === "final2" && renderFinal2Screen()}
      {fullScreen === "results" && renderResultsScreen()}

      <footer className="footer">
        <div className="container footerin">
          <span>
            CYBERSTAT · DIGITAL COMPETITION ARENA
          </span>

          <span>
            XAVFSIZ · MARKAZLASHGAN · REAL VAQT
          </span>
        </div>
      </footer>

      <nav className="mobile">
        {nav.map(([id, label]) => (
          <button
            className={
              active === id ? "active" : ""
            }
            onClick={() => {
                if (id === "final2" || id === "results") {
                  setActive(id);
                  setFullScreen(id);
                  return;
                }
                go(id);
              }}
            key={id}
          >
            {id === "home"
              ? "⌂"
              : id === "final2"
              ? "◉"
              : id === "results"
              ? "▣"
              : "★"}
            <br />
            {label}
          </button>
        ))}
      </nav>

      {selected && (
        <Modal
          candidate={selected}
          progress={
            taskProgress[selected.id] ?? 0
          }
          close={() => setSelected(null)}
        />
      )}
    </div>
  );
}
