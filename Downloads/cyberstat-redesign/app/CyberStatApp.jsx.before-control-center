function Visual({ index, image, project }) {
  if (image) {
    return (
      <div className="visual has-image">
        <img
          src={image}
          alt={project}
        />
      </div>
    );
  }

  return (
    <div className="visual">
      <div className="vicon">
        {index === 0 ? (
          <Shield />
        ) : index === 1 ? (
          <Activity />
        ) : (
          <Zap />
        )}
      </div>
    </div>
  );
}

function TaskStars({ progress, interactive = false, onToggle }) {
  return (
    <div
      className={
        interactive ? "taskstars adminstars" : "taskstars"
      }
    >
      {Array.from({ length: TASK_COUNT }, (_, i) => {
        const done = i < progress;

        return (
          <button
            key={i}
            type="button"
            className={done ? "done" : ""}
            disabled={!interactive}
            onClick={() => interactive && onToggle?.(i)}
            aria-label={`Topshiriq ${i + 1}`}
          >
            {done ? "★" : "☆"}
          </button>
        );
      })}
    </div>
  );
}

function Modal({ candidate, progress, close }) {
  const percent = Math.round((progress / TASK_COUNT) * 100);

  return (
    <div
      className="modalbg"
      onMouseDown={(e) => {
        if (e.target === e.currentTarget) close();
      }}
    >
      <div className="modal">
