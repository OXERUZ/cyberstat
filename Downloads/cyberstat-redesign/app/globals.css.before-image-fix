@media(max-width:1050px){.nav{padding:0 20px}.links{display:none}.hero{grid-template-columns:1fr}.stats{grid-template-columns:1fr 1fr}.cards{grid-template-columns:1fr 1fr}.lower{grid-template-columns:1fr 1fr}}
@media(max-width:650px){.container{width:calc(100% - 28px)}.nav{height:62px;padding:0 13px}.brand{min-width:0}.brand strong{font-size:17px}.brand small{font-size:6px}.logo{width:34px;height:34px}.live{padding:7px 9px}.admin{padding:7px 9px;font-size:8px}.hero{padding:45px 0 25px;min-height:auto}.hero h1{font-size:57px;letter-spacing:-3px}.hero h2{font-size:14px;letter-spacing:2px}.hero p{font-size:11px}.hero-art{min-height:285px}.orbit{width:265px}.final{top:27px;width:245px;padding:14px}.final h3{font-size:16px}.final p{font-size:8px}.stats,.cards,.lower{grid-template-columns:1fr}.section{padding:34px 0}.head{display:block}.head h2{font-size:28px}.mobile{position:fixed;display:grid;grid-template-columns:repeat(4,1fr);z-index:50;left:10px;right:10px;bottom:10px;padding:6px;border:1px solid var(--line);border-radius:15px;background:rgba(5,9,14,.92);backdrop-filter:blur(18px)}.mobile button{border:0;background:none;color:#71869a;font-size:8px;padding:7px 2px}.mobile button.active{color:var(--cyan)}.footer{padding-bottom:88px}.footerin{display:block}.footerin span{display:block;margin:4px 0}.detail{grid-template-columns:1fr}.detailvisual{min-height:190px}.infogrid{grid-template-columns:1fr}}


/* FINAL 2 / 10 ADMIN-CONTROLLED TASK STARS */
.taskstars{display:flex;align-items:center;gap:2px;white-space:nowrap;}
.taskstars button{border:0;background:transparent;color:#344052;padding:0;font-size:14px;line-height:1;cursor:default;font-family:inherit;}
.taskstars button.done{color:var(--gold);text-shadow:0 0 8px rgba(245,197,66,.35);}
.adminsection{margin-bottom:100px;}
.admincards{display:grid;gap:14px;}
.admincard{display:grid;grid-template-columns:1fr auto;gap:28px;align-items:center;padding:22px;border:1px solid rgba(0,217,255,.16);background:rgba(11,16,23,.88);border-radius:14px;box-shadow:0 0 30px rgba(0,0,0,.2);}
.admincard h3{margin:5px 0 0;}
.adminprogress{min-width:340px;display:grid;grid-template-columns:auto auto;gap:8px 16px;align-items:center;}
.adminprogress .taskstars{grid-column:1 / -1;}
.adminstars button{cursor:pointer;font-size:25px;padding:2px 3px;transition:transform .15s ease,color .15s ease;}
.adminstars button:hover{transform:translateY(-2px);color:var(--gold);}
.adminprogress strong{color:var(--cyan);font-family:var(--mono);font-size:13px;}
.adminprogress small{color:var(--muted);font-size:11px;}
@media(max-width:720px){.admincard{grid-template-columns:1fr;}.adminprogress{min-width:0;width:100%;}.adminstars{flex-wrap:wrap;gap:4px;}.adminstars button{font-size:23px;}}
/* ================================
   CYBERSTAT ADMIN CONTROL CENTER
================================ */

.admin.active{
  border-color:rgba(0,217,255,.7);
  color:var(--cyan);
  background:rgba(0,217,255,.08);
}

.adminsection{
  margin-bottom:100px;
  border-top:1px solid rgba(0,217,255,.12);
  padding-top:55px;
}

.adminblock{
  margin-top:30px;
}

.adminblockhead{
  display:flex;
  justify-content:space-between;
  align-items:end;
  gap:20px;
  margin-bottom:15px;
}

.adminblockhead h3{
  margin:0;
  font:700 18px 'Space Grotesk';
}

.adminblockhead p{
  margin:5px 0 0;
  color:var(--muted);
  font-size:10px;
}

.adminidentity{
  display:flex;
  align-items:center;
  gap:16px;
}

.adminimage{
  width:76px;
  height:76px;
  flex-shrink:0;
  display:grid;
  place-items:center;
  overflow:hidden;
  border:1px solid rgba(0,217,255,.25);
  border-radius:12px;
  color:var(--cyan);
  background:
    radial-gradient(
      circle,
      rgba(0,217,255,.15),
      transparent 60%
    ),
    #071019;
}

.adminimage img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.finalistadmin{
  display:block;
}

.finalistadmin > .adminidentity{
  margin-bottom:22px;
}

.adminform{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:13px;
}

.adminform label,
.adminresult label{
  display:flex;
  flex-direction:column;
  gap:6px;
  color:#71869a;
  font-size:8px;
  letter-spacing:1px;
}

.adminform label:nth-child(4),
.adminform label:nth-child(5){
  grid-column:1 / -1;
}

.adminform input,
.adminform textarea,
.adminresult input{
  width:100%;
  border:1px solid #1b3042;
  border-radius:9px;
  outline:none;
  background:#071019;
  color:#edf5ff;
  padding:11px 12px;
  font:500 11px Inter, sans-serif;
  transition:.18s;
}

.adminform textarea{
  min-height:80px;
  resize:vertical;
}

.adminform input:focus,
.adminform textarea:focus,
.adminresult input:focus{
  border-color:rgba(0,217,255,.65);
  box-shadow:0 0 0 3px rgba(0,217,255,.06);
}

.checkboxline{
  grid-column:1 / -1;
  flex-direction:row !important;
  align-items:center;
  gap:9px !important;
  color:var(--gold) !important;
}

.checkboxline input{
  width:17px;
  height:17px;
  accent-color:var(--gold);
}

.adminactions{
  display:flex;
  justify-content:flex-end;
  margin-top:17px;
}

.admincard{
  position:relative;
}

.adminprogress{
  min-width:340px;
  display:grid;
  grid-template-columns:auto auto;
  gap:8px 16px;
  align-items:center;
}

.adminprogress .taskstars{
  grid-column:1 / -1;
}

.adminprogress strong{
  color:var(--cyan);
  font-size:13px;
}

.adminprogress small{
  color:var(--muted);
  font-size:10px;
}

.taskstars{
  display:flex;
  align-items:center;
  gap:2px;
  white-space:nowrap;
}

.taskstars button{
  border:0;
  background:transparent;
  color:#344052;
  padding:0;
  font-size:14px;
  line-height:1;
  cursor:default;
  font-family:inherit;
}

.taskstars button.done{
  color:var(--gold);
  text-shadow:0 0 8px rgba(245,197,66,.35);
}

.adminstars button{
  cursor:pointer;
  font-size:25px;
  padding:2px 3px;
  transition:
    transform .15s ease,
    color .15s ease;
}

.adminstars button:hover{
  transform:translateY(-2px) scale(1.08);
  color:var(--gold);
}

.adminresult{
  display:grid;
  grid-template-columns:1fr 160px 130px auto;
  gap:15px;
  align-items:end;
  padding:15px 0;
  border-top:1px solid rgba(23,37,53,.65);
}

.adminresult:first-child{
  border-top:0;
}

.adminresulttitle{
  display:flex;
  align-items:center;
  gap:12px;
}

.adminresulttitle > b{
  color:var(--cyan);
  font:700 15px 'Space Grotesk';
}

.adminresulttitle strong{
  display:block;
  font-size:10px;
}

.adminresulttitle small{
  display:block;
  color:var(--muted);
  font-size:8px;
  margin-top:4px;
}

.adminform + .adminactions .secondary,
.adminactions .secondary{
  min-height:38px;
}

@media(max-width:900px){
  .adminform{
    grid-template-columns:1fr;
  }

  .adminform label:nth-child(4),
  .adminform label:nth-child(5){
    grid-column:auto;
  }

  .adminresult{
    grid-template-columns:1fr 1fr;
  }

  .adminresulttitle{
    grid-column:1 / -1;
  }
}

@media(max-width:720px){
  .adminblockhead{
    display:block;
  }

  .adminblockhead .status{
    margin-top:10px;
  }

  .admincard{
    grid-template-columns:1fr;
  }

  .adminprogress{
    min-width:0;
    width:100%;
  }

  .adminstars{
    flex-wrap:wrap;
    gap:4px;
  }

  .adminstars button{
    font-size:23px;
  }

  .adminresult{
    grid-template-columns:1fr;
  }

  .adminresulttitle{
    grid-column:auto;
  }

  .adminresult .secondary{
    width:100%;
    justify-content:center;
  }
}

/* =========================================================
   CYBERSTAT ADMIN LOGIN MODAL
   ========================================================= */

.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 99999;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 24px;

  background:
    radial-gradient(
      circle at center,
      rgba(0, 217, 255, 0.08),
      transparent 38%
    ),
    rgba(2, 5, 9, 0.88);

  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}

.modal-backdrop::before {
  content: "";
  position: absolute;
  inset: 0;

  background-image:
    linear-gradient(
      rgba(0, 217, 255, 0.025) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(0, 217, 255, 0.025) 1px,
      transparent 1px
    );

  background-size: 32px 32px;
  pointer-events: none;
}

.modal {
  position: relative;
  z-index: 2;

  width: min(460px, 100%);

  padding: 30px;

  border: 1px solid rgba(0, 217, 255, 0.28);
  border-radius: 20px;

  background:
    linear-gradient(
      145deg,
      rgba(11, 16, 23, 0.98),
      rgba(5, 7, 10, 0.98)
    );

  box-shadow:
    0 0 0 1px rgba(0, 217, 255, 0.04),
    0 30px 100px rgba(0, 0, 0, 0.65),
    0 0 45px rgba(0, 217, 255, 0.08);

  animation: cyberModalIn 0.22s ease-out;
}

@keyframes cyberModalIn {
  from {
    opacity: 0;
    transform: translateY(12px) scale(0.97);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.modal-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 20px;
  margin-bottom: 28px;
}

.modal-head h2 {
  margin: 6px 0 0;

  color: #f4f7fa;

  font-size: 24px;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.eyebrow {
  display: block;

  color: #00d9ff;

  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.18em;
}

.iconbtn {
  width: 38px;
  height: 38px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 10px;

  background: rgba(255, 255, 255, 0.035);

  color: #718096;

  font-size: 25px;
  line-height: 1;

  cursor: pointer;

  transition:
    border-color 0.2s ease,
    color 0.2s ease,
    background 0.2s ease;
}

.iconbtn:hover {
  color: #f4f7fa;

  border-color: rgba(255, 59, 92, 0.45);

  background: rgba(255, 59, 92, 0.08);
}

.modal form {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.modal form label {
  display: flex;
  flex-direction: column;

  gap: 8px;

  color: #718096;

  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.modal form input {
  width: 100%;
  height: 50px;

  box-sizing: border-box;

  padding: 0 15px;

  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 11px;

  outline: none;

  background: rgba(255, 255, 255, 0.035);

  color: #f4f7fa;

  font-family: inherit;
  font-size: 14px;

  transition:
    border-color 0.2s ease,
    background 0.2s ease,
    box-shadow 0.2s ease;
}

.modal form input::placeholder {
  color: #4d5968;
}

.modal form input:focus {
  border-color: rgba(0, 217, 255, 0.65);

  background: rgba(0, 217, 255, 0.035);

  box-shadow:
    0 0 0 3px rgba(0, 217, 255, 0.08),
    0 0 25px rgba(0, 217, 255, 0.05);
}

.errorbox {
  padding: 12px 14px;

  border: 1px solid rgba(255, 59, 92, 0.35);
  border-radius: 10px;

  background: rgba(255, 59, 92, 0.07);

  color: #ff7188;

  font-size: 12px;
  line-height: 1.5;
}

.modal .primary {
  width: 100%;
  height: 50px;

  margin-top: 4px;

  border: 1px solid rgba(0, 217, 255, 0.45);
  border-radius: 11px;

  background:
    linear-gradient(
      135deg,
      rgba(0, 217, 255, 0.18),
      rgba(37, 99, 235, 0.2)
    );

  color: #f4f7fa;

  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.12em;

  cursor: pointer;

  transition:
    border-color 0.2s ease,
    background 0.2s ease,
    box-shadow 0.2s ease,
    transform 0.2s ease;
}

.modal .primary:hover:not(:disabled) {
  border-color: #00d9ff;

  background:
    linear-gradient(
      135deg,
      rgba(0, 217, 255, 0.25),
      rgba(37, 99, 235, 0.28)
    );

  box-shadow:
    0 0 25px rgba(0, 217, 255, 0.13);

  transform: translateY(-1px);
}

.modal .primary:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

@media (max-width: 600px) {
  .modal-backdrop {
    padding: 16px;
  }

  .modal {
    width: 100%;
    padding: 23px;

    border-radius: 16px;
  }

  .modal-head h2 {
    font-size: 20px;
  }
}
