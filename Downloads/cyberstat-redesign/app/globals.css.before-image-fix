.hero-art{min-height:400px;display:grid;place-items:center;position:relative}.orbit{width:min(400px,70vw);aspect-ratio:1;border:1px solid rgba(0,217,255,.3);border-radius:50%;box-shadow:0 0 90px rgba(0,217,255,.08),inset 0 0 70px rgba(124,58,237,.1);position:relative}.orbit:before,.orbit:after{content:"";position:absolute;inset:10%;border:1px dashed rgba(124,58,237,.3);border-radius:50%;transform:rotate(27deg)}.orbit:after{inset:19%;transform:rotate(-36deg);border-color:rgba(0,217,255,.2)}.core{position:absolute;inset:24%;border-radius:50%;background:radial-gradient(circle at 35% 30%,#223f7c,#07111d 56%,#04070b);box-shadow:0 0 70px rgba(0,217,255,.2),inset 0 0 70px rgba(124,58,237,.2)}
