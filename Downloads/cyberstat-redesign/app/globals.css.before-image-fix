.section{padding:45px 0}.head{display:flex;justify-content:space-between;align-items:end;margin-bottom:20px}.head small{color:var(--cyan);font-size:8px;letter-spacing:2px}.head h2{font:700 33px 'Space Grotesk';margin:7px 0}.head p{color:#708397;font-size:10px;margin:0}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.card{overflow:hidden;transition:.22s}.card:hover{transform:translateY(-4px);border-color:rgba(0,217,255,.48);box-shadow:0 20px 60px rgba(0,217,255,.06)}.card.top{border-color:rgba(124,58,237,.7)}.visual{height:178px;display:grid;place-items:center;position:relative;background:radial-gradient(circle at 60% 35%,rgba(0,217,255,.25),transparent 23%),linear-gradient(135deg,#07111d,#10162c 45%,#080a12)}.visual:before{content:"";position:absolute;width:225px;height:225px;border:1px solid rgba(0,217,255,.15);border-radius:50%;box-shadow:0 0 0 27px rgba(124,58,237,.025),0 0 0 54px rgba(0,217,255,.02)}.vicon{width:68px;height:68px;z-index:1;border:1px solid rgba(0,217,255,.4);border-radius:18px;display:grid;place-items:center;color:var(--cyan);background:rgba(0,217,255,.07)}.rank{position:absolute;z-index:2;left:12px;top:12px;background:#03070ccc;border:1px solid var(--line);border-radius:8px;padding:6px 8px;font:700 13px 'Space Grotesk'}.badge{position:absolute;z-index:2;right:12px;top:12px;color:var(--gold);border:1px solid rgba(245,197,66,.5);background:rgba(245,197,66,.07);border-radius:999px;padding:5px 8px;font-size:7px}.body{padding:17px}.author{color:#6f8398;font-size:8px;letter-spacing:1px}.body h3{font:700 20px 'Space Grotesk';margin:7px 0}.project{color:#8598ab;font-size:9px}.progressline{display:flex;justify-content:space-between;margin-top:17px;color:#708399;font-size:8px}.stars{color:var(--gold);letter-spacing:2px;font-size:12px}.bar{height:6px;background:#12202e;border-radius:99px;margin-top:8px;overflow:hidden}.bar i{display:block;height:100%;background:linear-gradient(90deg,var(--cyan),var(--violet));border-radius:99px}.foot{display:flex;justify-content:space-between;align-items:center;margin-top:14px}.status{border:1px solid rgba(0,217,255,.28);color:var(--cyan);display:inline-flex;align-items:center;gap:5px}
.lower{display:grid;grid-template-columns:1fr 1fr .75fr;gap:15px}.panel{padding:19px}.panel h3{font:600 16px 'Space Grotesk';margin:0}.panelhead{display:flex;justify-content:space-between;margin-bottom:13px}.row{display:grid;grid-template-columns:34px 1fr auto;gap:10px;align-items:center;padding:12px 0;border-top:1px solid rgba(23,37,53,.65)}.row:first-of-type{border-top:0}.num{color:#7190ac;font:700 12px 'Space Grotesk'}.row strong{display:block;font-size:10px}.row small{display:block;color:#64778b;font-size:7px;margin-top:3px}.end{text-align:right}.end strong{font:700 11px 'Space Grotesk'}.mini{height:4px;width:110px;background:#152435;border-radius:99px;margin-top:5px}.mini i{display:block;height:100%;background:linear-gradient(90deg,var(--cyan),var(--violet));border-radius:99px}.vip{display:flex;align-items:center;gap:13px;margin-top:18px}.vipicon{width:52px;height:52px;border-radius:15px;display:grid;place-items:center;color:var(--gold);border:1px solid rgba(245,197,66,.4);background:rgba(245,197,66,.08)}.vip h3{font:700 17px 'Space Grotesk';margin:0}.vip p{color:#788b9f;font-size:8px}.footer{border-top:1px solid var(--line);padding:28px 0;margin-top:25px;color:#566a7e;font-size:8px}.footerin{display:flex;justify-content:space-between}.mobile{display:none}
