.live,.admin,.status{border-radius:999px;padding:8px 12px;font-size:9px;letter-spacing:1px}.live{border:1px solid rgba(0,217,255,.45);color:var(--cyan);display:flex;gap:7px;align-items:center}.dot{width:7px;height:7px;border-radius:50%;background:var(--cyan);box-shadow:0 0 12px var(--cyan)}.admin{border:1px solid rgba(124,58,237,.6);background:rgba(124,58,237,.08);color:#cbb8ff}
